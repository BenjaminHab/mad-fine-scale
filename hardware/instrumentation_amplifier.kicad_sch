	(text "Gain = 1 + R_F ⁄ R_G\nGain = 1 + R_F / (R_GS + R_GV * R_GP / (R_GV + R_GP))\nG_max = 1 + R_F / (R_GS + R_GV_min * R_GP / (R_GV_min + R_GP))\nG_min = 1 + R_F / (R_GS + R_GV_max * R_GP / (R_GV_max + R_GP))\n\nCalculations let me believe, that R_F=330k, R_GP=inf and R_GS=1k are a good combination"
		(exclude_from_sim no)
		(at 94.996 20.828 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0fde65c8-8d61-4531-8a4c-a3c1c29fff74")
	)
	(text "According to AoE, an estimate for the maximum load cell differential voltage\nis ~2mV per Volt of supply voltage, i.e. I can expect a differential voltage\n in the range +-6.66mV."
		(exclude_from_sim no)
		(at 66.548 108.712 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
